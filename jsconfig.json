{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "lib": ["ES2024", "WebWorker"],
    "types": ["@cloudflare/workers-types", "vitest/globals"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "test/repository/**/*.js",
    "scripts/**/*.mjs",
    "eslint.config.js",
    "vitest.config.js"
  ]
}
