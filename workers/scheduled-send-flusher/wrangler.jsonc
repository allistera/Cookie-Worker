{
  "name": "scheduled-send-flusher",
  "main": "src/index.js",
  // The HTTP trigger (POST /run) is served from the workers.dev URL.
  "workers_dev": true,
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2,
  },
  "triggers": {
    // Cron Triggers run on UTC. On-time delivery is the ScheduledSendClock
    // alarm inside cookie-web-send; this tick is the safety net for retries,
    // expired leases, a lost alarm, and the housekeeping sweeps, so it bounds
    // how long a failed first attempt waits before its retry.
    "crons": ["*/15 * * * *"],
  },
  // The flush call goes over a service binding to cookie-web-send: zero-cost,
  // never leaves Cloudflare. The COOKIE_WEB_FLUSH_TOKEN secret still rides
  // along because /send/flush is also publicly routable on its own domain and
  // must stay protected there (cookie-web-send syncs the same value as
  // SCHEDULED_SEND_FLUSH_TOKEN).
  "services": [{ "binding": "SEND", "service": "cookie-web-send" }],
  "vars": {
    "SENTRY_ENVIRONMENT": "production",
  },
}
