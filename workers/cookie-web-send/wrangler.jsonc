{
  "name": "cookie-web-send",
  "main": "src/index.js",
  // Two kinds of caller: Cookie-Web's SPA sends and manages scheduled mail
  // from the browser (cross-origin, CORS + Auth0 like the other SPA Workers),
  // and the scheduled-send-flusher Worker calls POST /send/flush over a
  // service binding, bearer-authenticated because this route is also publicly
  // routable. workers.dev stays enabled alongside the custom domain below for
  // debugging.
  "workers_dev": true,
  "routes": [{ "pattern": "send-api.infinitywave.online", "custom_domain": true }],
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Every request opens a Hyperdrive connection before any route work, so
  // run the isolate near the database rather than near the browser.
  "placement": { "mode": "smart" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "a276ebeb4ec84d33b050614b6b5020e5" }],
  // Exact-time "Send Later" delivery: one alarm per the earliest pending send
  // (src/scheduledSendClock.js). The flusher cron remains the safety net.
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULED_SEND_CLOCK", "class_name": "ScheduledSendClock" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScheduledSendClock"] }],
  "vars": {
    // Auth0 domain/audience are public identifiers, already shipped in
    // Cookie-Web's own client bundle (VITE_AUTH0_DOMAIN/VITE_AUTH0_AUDIENCE)
    // — not secrets.
    // The custom domain issues tokens now; the tenant domain stays listed
    // until every signed-in client has re-authenticated against the new one
    // (see shared/auth-jwt.js). Drop it after that.
    "AUTH0_DOMAIN": "auth.infinitywave.online,dev-ixcl1rgxrlgeqrvs.us.auth0.com",
    "AUTH0_AUDIENCE": "https://cookie-web/api",
    // Cookie-Web's production origin, for the CORS allowlist.
    "ALLOWED_ORIGIN": "https://mail.infinitywave.online",
    "SENTRY_ENVIRONMENT": "production",
    // Meilisearch Cloud endpoint, so a sent copy is indexed as it is stored
    // instead of waiting for the drift sweep. The API key is a secret
    // (MEILISEARCH_API_KEY) set via `wrangler secret put`, like the other
    // Workers that write to the index; with either missing the sync no-ops.
    "MEILISEARCH_URL": "https://ms-52028f71df74-53700.lon.meilisearch.io",
  },
  // EMAIL_FROM (the visible From for outbound mail), RESEND_API_KEY, and
  // BLOB_READ_WRITE_TOKEN are Worker secrets rather than vars. See the deploy
  // workflow's cookie-web-send step for the synchronized secret inventory.
}
