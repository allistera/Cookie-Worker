{
  "name": "cookie-web-automations",
  "main": "src/index.js",
  // Called directly by Cookie-Web's SPA from the browser. workers.dev stays
  // enabled alongside the custom domain below for debugging — both reach the
  // same Worker, and CORS/auth apply equally to either.
  "workers_dev": true,
  "routes": [{ "pattern": "automations-api.infinitywave.online", "custom_domain": true }],
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  // Cron Triggers run on UTC. Each tick runs the automations whose schedule
  // has come due since the last one, so a scheduled time is kept to within
  // five minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2,
    // Export Cloudflare automatic traces over OTLP to Honeycomb (EU). The
    // endpoint and API key live in the "honeycomb-traces" destination in the
    // Cloudflare dashboard, not in this repo.
    "traces": { "enabled": true, "destinations": ["honeycomb-traces"], "head_sampling_rate": 0.2 },
    // Group uncaught exceptions, failed invocations, 5xx responses and error
    // logs into Workers Issues. A deploy without this key turns Issues off.
    "issues": { "enabled": true },
  },
  // Every request opens a Hyperdrive connection before any route work, so
  // run the isolate near the database (Supabase, AWS us-east-1) rather than
  // near the browser (README, "Worker placement").
  "placement": { "region": "aws:us-east-1" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "a276ebeb4ec84d33b050614b6b5020e5" }],
  // An automation changes Cookie's data through the API Worker that owns it,
  // over that Worker's service-binding-only Internal entrypoint
  // (shared/internal-entrypoint.js), so a run goes through the same
  // validation and side effects as the same change made in the app.
  "services": [{ "binding": "TASKS", "service": "cookie-web-tasks", "entrypoint": "Internal" }],
  // Analytics Engine: one row per HTTP request (service, method, route,
  // duration, status; shared/responseMetrics.js) and one per database query
  // (shared/sqlMetrics.js).
  "analytics_engine_datasets": [
    { "binding": "RESPONSE_METRICS", "dataset": "cookie_response_times" },
    { "binding": "SQL_METRICS", "dataset": "cookie_sql_queries" },
  ],
  "vars": {
    // Auth0 domain/audience are public identifiers, already shipped in
    // Cookie-Web's own client bundle (VITE_AUTH0_DOMAIN/VITE_AUTH0_AUDIENCE)
    // — not secrets.
    // The custom domain issues tokens now; the tenant domain stays listed
    // until every signed-in client has re-authenticated against the new one
    // (see shared/auth-jwt.js). Drop it after that.
    "AUTH0_DOMAIN": "auth.infinitywave.online,dev-ixcl1rgxrlgeqrvs.us.auth0.com",
    "AUTH0_AUDIENCE": "https://cookie-web/api",
    // Cookie-Web's production origin, for the CORS allowlist.
    "ALLOWED_ORIGIN": "https://mail.infinitywave.online",
    "SENTRY_ENVIRONMENT": "production",
  },
}
