{
  "name": "cookie-web-tasks",
  "main": "src/index.js",
  // Called directly by Cookie-Web's SPA from the browser. workers.dev stays
  // enabled alongside the custom domain below for debugging — both reach the
  // same Worker, and CORS/auth apply equally to either.
  "workers_dev": true,
  "routes": [{ "pattern": "tasks-api.infinitywave.online", "custom_domain": true }],
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.2 },
  // Every request opens a Hyperdrive connection before any route work, so
  // run the isolate near the database rather than near the browser.
  "placement": { "mode": "smart" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "a276ebeb4ec84d33b050614b6b5020e5" }],
  // Worker-to-Worker call for POST /tasks/refresh: zero-cost, never leaves
  // Cloudflare, no public URL involved. The matching ENRICHER_TRIGGER_TOKEN
  // secret is still sent — data-enricher's /run stays token-protected because
  // it is also publicly routable on its own workers.dev URL.
  "services": [{ "binding": "ENRICHER", "service": "data-enricher" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "cookie-files" }],
  "vars": {
    // Auth0 domain/audience are public identifiers, already shipped in
    // Cookie-Web's own client bundle (VITE_AUTH0_DOMAIN/VITE_AUTH0_AUDIENCE)
    // — not secrets.
    // The custom domain issues tokens now; the tenant domain stays listed
    // until every signed-in client has re-authenticated against the new one
    // (see shared/auth-jwt.js). Drop it after that.
    "AUTH0_DOMAIN": "auth.infinitywave.online,dev-ixcl1rgxrlgeqrvs.us.auth0.com",
    "AUTH0_AUDIENCE": "https://cookie-web/api",
    // Cookie-Web's production origin, for the CORS allowlist. Update once
    // this Worker moves off the shared allow-any-*.vercel.app fallback.
    "ALLOWED_ORIGIN": "https://mail.infinitywave.online",
    "SENTRY_ENVIRONMENT": "production",
    // Must match data-enricher's OWNER_EMAIL: /tasks/refresh rebuilds that
    // fixed mailbox's AI state, so only this account may trigger it.
    "OWNER_EMAIL": "allisteraall@gmail.com",
    // Meilisearch Cloud endpoint for document search and sync. The index
    // name itself is not configured here — DOCUMENTS_INDEX.name in
    // shared/meili/documents.js hardcodes 'documents'. MEILISEARCH_API_KEY
    // is a wrangler secret and must be set before deploy. If Meilisearch is
    // unreachable or misconfigured, document search returns 503 rather than
    // silently falling back to Postgres (?engine=postgres in documents.js
    // is the only way to reach Postgres).
    "MEILISEARCH_URL": "https://ms-52028f71df74-53700.lon.meilisearch.io",
  },
}
