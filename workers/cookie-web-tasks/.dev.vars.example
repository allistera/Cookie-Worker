# The database connection comes from the Hyperdrive binding, not a secret.
# For local dev, export this before `npm run dev` (dev Supabase project, session pooler):
#   export CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Lets POST /tasks/refresh trigger the data-enricher Worker's on-demand
# rebuild over the ENRICHER service binding (run `npm run dev -- data-enricher`
# alongside so wrangler can connect the two locally). Without the token,
# refresh responds 501.
ENRICHER_TRIGGER_TOKEN=""

# Upload access for document images and /tasks/image-upload. Same store,
# same token as mail-app-ingest's and cookie-web-messages's
# BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=""

# Optional locally; required in production to send sanitized errors to Sentry.
SENTRY_DSN=""
