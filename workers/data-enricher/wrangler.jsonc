{
  "name": "data-enricher",
  "main": "src/entry.py",
  "workers_dev": false,
  "compatibility_date": "2026-07-09",
  // The `workers` SDK and PyPI packages are vendored into python_modules by
  // pywrangler (uv run pywrangler ...); dev and deploy must go through it.
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Cron Triggers run on UTC.
    "crons": ["0 5 * * *"]
  }
}
