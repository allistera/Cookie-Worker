{
  "name": "data-enricher",
  "main": "src/index.js",
  "workers_dev": false,
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Cron Triggers run on UTC.
    "crons": ["0 5 * * *"]
  },
  "vars": {
    // Comma-separated URLs of the MCP servers to gather results from.
    "MCP_SERVERS": ""
  }
}
