{
  "name": "data-enricher",
  "main": "src/index.js",
  // The HTTP trigger (POST /run) is served from the workers.dev URL.
  "workers_dev": true,
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Export Cloudflare automatic traces over OTLP to Honeycomb (EU). The
    // endpoint and API key live in the "honeycomb-traces" destination in the
    // Cloudflare dashboard, not in this repo.
    "traces": { "enabled": true, "destinations": ["honeycomb-traces"], "head_sampling_rate": 1 },
    // Group uncaught exceptions, failed invocations, 5xx responses and error
    // logs into Workers Issues. A deploy without this key turns Issues off.
    "issues": { "enabled": true },
  },
  "triggers": {
    // Cron Triggers run on UTC.
    "crons": ["0 * * * *"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a276ebeb4ec84d33b050614b6b5020e5",
    },
  ],
  // One Analytics Engine row per HTTP response (service, duration, status);
  // see shared/responseMetrics.js.
  "analytics_engine_datasets": [
    { "binding": "RESPONSE_METRICS", "dataset": "cookie_response_times" },
  ],
  "vars": {
    "AI_MODEL": "gpt-5-nano",
    "OWNER_EMAIL": "allisteraall@gmail.com",
    "SENTRY_ENVIRONMENT": "production",
    // OpenAI calls go through Cloudflare AI Gateway once AI_GATEWAY_ID names
    // a gateway on this account (shared/openai.js); without it they go
    // straight to api.openai.com. The account id is a public identifier.
    "CLOUDFLARE_ACCOUNT_ID": "b581e48529728e578cea1d0b0a2ecab3",
    "AI_GATEWAY_ID": "cookie",
  },
}
